LISTEN_ADDR=:8080
DATA_DIR=./data
SESSION_TTL=168h
# 生产经 Caddy/Nginx 提供 HTTPS 时务必设为 true；本地 http 调试保持 false
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
# 仅信任反向代理来源（同机 Caddy 用 127.0.0.1/::1；远程反代填其 IP/CIDR）
TRUSTED_PROXIES=127.0.0.1,::1
MAX_FILE_SIZE=2147483648
PART_SIZE=5242880
MAX_UPLOAD_CONCURRENCY=3
ROOM_MAX_PEERS=8
ROOM_IDLE_TIMEOUT=30m
# 房间自创建起最长保留时间
ROOM_MAX_AGE=24h
ROOM_CREATE_PER_MIN=10
STUN_SERVERS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
CLEANUP_INTERVAL=1m
TEMP_TTL=24h
